# ============================================================
# GridGo 生产环境变量模板（复制为 deploy/gridgo.env 后填写）
# ============================================================
# 说明：
#   1. 该文件（及生成出的 gridgo.env）已被 .gitignore 忽略，绝不入库；
#   2. 后端 Settings 为 extra=forbid（pydantic-settings），env_file 内**只能**出现
#      gridgo-server/app/core/config.py 已声明的键，写别的键会导致容器启动直接失败；
#   3. deploy/deploy-remote.sh 会自动完成「复制本文件 + 填充随机密钥 + 创建 PG 库/用户」，
#      手工部署时按下面的占位符自行替换。
#
# 占位符一览（脚本会 sed 替换）：
#   <POSTGRES_PASSWORD>     PostgreSQL 中 gridgo 用户的密码（openssl rand -hex 24）
#   <openssl rand -hex 32>  JWT 签名密钥
#   <服务器IP>              服务器公网 IP（脚本用 ifconfig.me 探测）

# === 应用 ===
APP_NAME=GridGo
APP_VERSION=0.1.0
DEBUG=False

# === 后端监听（容器内固定 8001，不要改）===
HOST=0.0.0.0
PORT=8001

# === PostgreSQL：复用 OJ 的 deploy-postgres-1 容器（本项目不新起数据库）===
# 库名/用户名/密码均取自本 URL：deploy-remote.sh 会据此幂等创建角色与库
DATABASE_URL=postgresql+asyncpg://gridgo:<POSTGRES_PASSWORD>@deploy-postgres-1:5432/gridgo
DATABASE_ECHO=False

# === Redis：复用 OJ 的 deploy-redis-1（db1 与 OJ 的 db0 隔离）===
REDIS_URL=redis://deploy-redis-1:6379/1

# === JWT（生产必须为随机值）===
JWT_SECRET_KEY=<openssl rand -hex 32>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# === CORS（站点与 API 同源，本项对生产影响极小；保留本机调试来源）===
CORS_ORIGINS=["http://<服务器IP>:81","http://127.0.0.1:81"]

# === 雪花 ID 节点号（单实例保持 0；多实例部署才需区分，取值 0-1023）===
SNOWFLAKE_WORKER_ID=0

# === 游戏参数 ===
GAME_INITIAL_CASH=1500
GAME_PASS_GO_BONUS=200
GAME_TURN_TIMEOUT=30
GAME_MAX_PLAYERS=8
GAME_MAX_TURNS=100
