# GridGo 后端环境变量配置
# 复制此文件为 .env 并修改配置

# 应用
APP_NAME=GridGo
DEBUG=True

# 数据库 - MySQL
DATABASE_URL=mysql+aiomysql://root:rootpassword@localhost:3306/gridgo

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (生产环境务必修改！)
JWT_SECRET_KEY=gridgo-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
